PORT=4000

# Base de Datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=neondb
DATABASE_URL=your_database_url_here

# JWT KEY
JWT_SECRET=educonnect_secret_key
JWT_EXPIRES_IN=24h

# Cifrado del secreto TOTP (AES-256-GCM) - 32 caracteres UTF-8 o 64 hex
OTP_ENCRYPTION_KEY=una_clave_secreta_de_32_char

# Configuración de Correo (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_app_password
